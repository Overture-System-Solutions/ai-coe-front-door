# Dependencies
node_modules/

# SharePoint Framework / Heft build output
dist/
lib/
lib-dts/
lib-commonjs/
lib-esm/
jest-output/
release/
temp/
.heft/
sharepoint/solution/
*.sppkg
!original/*.sppkg
coverage/

# Generated code (typings and the Tailwind utility stylesheet are rebuilt by `heft build`)
*.resx.ts
*.scss.ts
src/webparts/aiCoeFrontDoor/styles/tailwind.generated.global.scss

# Logs
logs/
*.log
npm-debug.log*

# Python
__pycache__/
*.pyc
# pytest scratch space (--basetemp folders hold machine-local symlinks) and its cache
.pytest_cache/
pytest-tmp/
evidence/parent-native-tmp/
evidence/parent-native-complete-tmp/

# Secrets and local environment
.env
.env.*
*.pem
*.key
*.pfx

# OS / editor
.DS_Store
.vs/
.idea/
.ntvs_analysis.dat

# .NET build output of the local connector helpers (rebuilt from their source by `dotnet build`)
bin/
obj/
# The local .NET home those builds use (NuGet and SDK caches)
dotnet-home/

# Operator-filled page provisioning parameters (site-specific; copy parameters.sample.json).
# One file per site, so two sites' values never sit in the same file: parameters.json is the
# default the script reads, parameters.<site>.json is passed with -ParameterFile. The sample is
# the only one committed, and it carries no value.
sharepoint/pages/parameters.json
sharepoint/pages/parameters.*.json
!sharepoint/pages/parameters.sample.json

# Local editor and preview tooling
.claude/
