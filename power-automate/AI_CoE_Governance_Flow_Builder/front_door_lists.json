[
  {
    "title": "AI CoE Program Measures",
    "description": "One row per program measure the Enterprise value page reads: the measure, the period it covers, the evidence behind it and how many people it covers. Operators fill it in by hand; the front door only reads it, and a row that is not measured shows its plain placeholder instead of a number. A measure whose Unit is % is written as a proportion: 0.62 for 62%, and 1 for the whole, so a value between 0 and 1 is read as a share and a value above 1 is read as the percentage itself.",
    "fields": [
      {
        "name": "MeasureId",
        "type": "Text",
        "required": true,
        "indexed": true,
        "unique": true
      },
      {
        "name": "Value",
        "type": "Number"
      },
      {
        "name": "Unit",
        "type": "Text"
      },
      {
        "name": "State",
        "type": "Choice",
        "required": true,
        "choices": [
          "MEASURED",
          "NOT_ESTABLISHED",
          "PENDING_BASELINE",
          "NOT_AVAILABLE",
          "INSUFFICIENT_VOLUME"
        ]
      },
      {
        "name": "PeriodStart",
        "type": "DateTime"
      },
      {
        "name": "PeriodEnd",
        "type": "DateTime"
      },
      {
        "name": "EvidenceRef",
        "type": "Text"
      },
      {
        "name": "EvidenceNote",
        "type": "Note"
      },
      {
        "name": "CohortSize",
        "type": "Number"
      }
    ]
  },
  {
    "title": "AI CoE Outcome Records",
    "description": "One row per task outcome a person records: the kind of task, how it turned out, whether a person reviewed it, what kind of correction it needed and what the page said about the route. Nothing that was typed, prompted or produced is written here, and no column names the person; SharePoint's own Created By does that, which is why each person reads only their own row while operators and owners read them all.",
    "fields": [
      {
        "name": "OutcomeId",
        "type": "Text",
        "required": true,
        "indexed": true
      },
      {
        "name": "RecordedAt",
        "type": "DateTime"
      },
      {
        "name": "TaskType",
        "type": "Text"
      },
      {
        "name": "Outcome",
        "type": "Choice",
        "choices": [
          "Accepted",
          "Corrected",
          "Unavailable",
          "Stopped"
        ]
      },
      {
        "name": "ReviewState",
        "type": "Choice",
        "choices": [
          "Reviewed by me",
          "Reviewed by someone else",
          "Not reviewed"
        ]
      },
      {
        "name": "CorrectionCategory",
        "type": "Choice",
        "choices": [
          "fact",
          "source",
          "audience",
          "policy",
          "brand",
          "action boundary"
        ]
      },
      {
        "name": "RouteAvailability",
        "type": "Choice",
        "choices": [
          "Available now",
          "Draft only",
          "Needs approval",
          "Needs access",
          "Not supported"
        ]
      },
      {
        "name": "WorkflowVersion",
        "type": "Text"
      }
    ],
    "security": "ownItems",
    "fullControlGroups": [
      "OperatorsGroup"
    ],
    "hideFromDefaultView": [
      "Author",
      "Editor"
    ]
  },
  {
    "title": "AI CoE Approved Tools",
    "description": "One row per AI tool the AI CoE has reviewed: its status, what it is approved for, which kinds of information it may be used with, and its conditions. Operators and site owners keep it; everyone else reads it. The tool check and the AI CoE Assistant answer from these rows, so a tool that is not listed has not been reviewed, and a yes/no column left blank allows nothing.",
    "fields": [
      {
        "name": "ToolId",
        "type": "Text",
        "required": true,
        "indexed": true,
        "unique": true
      },
      {
        "name": "OtherNames",
        "type": "Note"
      },
      {
        "name": "Vendor",
        "type": "Text"
      },
      {
        "name": "Status",
        "type": "Choice",
        "required": true,
        "choices": [
          "Approved",
          "Approved with conditions",
          "Not approved",
          "Under review"
        ]
      },
      {
        "name": "ApprovedFor",
        "type": "Note"
      },
      {
        "name": "CompanyInfoAllowed",
        "type": "Boolean"
      },
      {
        "name": "EmployeeInfoAllowed",
        "type": "Boolean"
      },
      {
        "name": "CustomerInfoAllowed",
        "type": "Boolean"
      },
      {
        "name": "PatientInfoAllowed",
        "type": "Boolean"
      },
      {
        "name": "ConfidentialInfoAllowed",
        "type": "Boolean"
      },
      {
        "name": "RegulatedInfoAllowed",
        "type": "Boolean"
      },
      {
        "name": "FileUploadsAllowed",
        "type": "Boolean"
      },
      {
        "name": "ExternalSharingAllowed",
        "type": "Boolean"
      },
      {
        "name": "Conditions",
        "type": "Note"
      },
      {
        "name": "NotApprovedFor",
        "type": "Note"
      },
      {
        "name": "HowToGetAccess",
        "type": "Note"
      },
      {
        "name": "LastReviewed",
        "type": "DateTime"
      },
      {
        "name": "ReviewedBy",
        "type": "Text"
      }
    ],
    "security": "readOnly",
    "fullControlGroups": [
      "OperatorsGroup"
    ]
  }
]
