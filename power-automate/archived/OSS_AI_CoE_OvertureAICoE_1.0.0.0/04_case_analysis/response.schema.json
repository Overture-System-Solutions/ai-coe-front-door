                    "type": "string",
                    "minLength": 1,
                    "maxLength": 600,
                    "pattern": "\\S"
                  },
                  "whyItMatters": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 600,
                    "pattern": "\\S"
                  },
                  "suggestedNextStep": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 600,
                    "pattern": "\\S"
