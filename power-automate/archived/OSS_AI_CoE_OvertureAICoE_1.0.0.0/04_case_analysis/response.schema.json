    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ok",
        "schemaVersion",
        "requestId",
        "draftOnly",
        "humanReviewRequired",
        "provider",
        "model",
        "responseId",
        "caseCount",
        "truncated",
        "asOf",
        "analysis"
      ],
      "properties": {
        "ok": {
          "type": "boolean",
          "enum": [
            true
          ]
        },
        "schemaVersion": {
          "type": "string",
          "enum": [
            "1.0"
          ]
        },
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"
        },
        "draftOnly": {
          "type": "boolean",
          "enum": [
            true
          ]
