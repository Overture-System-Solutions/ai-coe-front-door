                }
              },
              "maxItems": 10
            },
            "patterns": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 600,
                "pattern": "\\S"
              },
              "maxItems": 8
            },
            "gaps": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 600,
                "pattern": "\\S"
              },
              "maxItems": 8
            }
          }
        }
      }
