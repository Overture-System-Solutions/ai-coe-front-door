{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "workflowId",
    "requestId",
    "demoDataOnly",
    "question"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "enum": [
        "1.0"
      ]
    },
    "workflowId": {
      "type": "string",
      "enum": [
        "caseAnalysis"
      ]
    },
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"
    },
    "demoDataOnly": {
      "type": "boolean",
      "enum": [
        true
      ]
    },
    "question": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1500,
      "pattern": "\\S"
    }
  }
}
