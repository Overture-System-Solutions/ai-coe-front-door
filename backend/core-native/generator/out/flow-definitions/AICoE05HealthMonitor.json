            "parameters": {
              "dataset": "@parameters('aicoe_SiteUrl (aicoe_SiteUrl)')",
              "parameters/method": "POST",
              "parameters/uri": "@concat('_api/web/lists(guid''', outputs('Cfg')?['ListId_Log'], ''')/items')",
